    "examples": [
      {
        "slave_address": 1,
        "positions": [0, 0, 0, 0, 0, 0, 0, 1],
        "calculation": "0+0+0+0+0+0+0+1=1"
      },
      {
        "slave_address": 2,
        "positions": [0, 0, 0, 0, 0, 0, 1, 0],
        "calculation": "0+0+0+0+0+0+2+0=2"
      },
      {
        "slave_address": 3,
        "positions": [0, 0, 0, 0, 0, 0, 1, 1],
        "calculation": "0+0+0+0+0+0+2+1=3"
      },
      {
        "slave_address": 176,
        "positions": [1, 0, 1, 1, 0, 0, 0, 0],
        "calculation": "128+0+32+16+0+0+0+0=176"
      }
    ],
    "power_cycle_rule": "DIP switch changes take effect only after full power cycle. Remove supply voltage for at least 5 seconds before re-applying. Modbus register 0x0004 may mirror address when programmed via bus."
  },

